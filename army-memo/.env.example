# Required for live drafting (POST /draft, CLI without --offline)
ANTHROPIC_API_KEY=

# Claude model id (structured JSON output). Override with MEMO_MODEL_PATH for
# the same value if you prefer the older env name from the tutorial example.
ANTHROPIC_MODEL=claude-sonnet-4-5
# MEMO_MODEL_PATH=claude-sonnet-4-5

# Optional drafting limits
MEMO_DRAFT_TIMEOUT_MS=120000
MEMO_MAX_TOKENS=4096
MEMO_DRAFT_RETRIES=2

# HTTP API
PORT=4250
HOST=127.0.0.1
